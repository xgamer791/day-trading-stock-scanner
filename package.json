{
  "name": "day-trading-stock-scanner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run fetch:live && next dev --turbopack",
    "fetch:live": "node scripts/build-universe.mjs && node scripts/fetch-live.mjs",
    "fetch:universe": "node scripts/build-universe.mjs",
    "prebuild": "npm run fetch:live",
    "build": "next build",
    "build:web": "GITHUB_PAGES=true next build",
    "build:ios": "CAPACITOR_BUILD=true next build && rm -rf out/data out/news-mockups && npx cap sync ios",
    "ios:copy": "CAPACITOR_BUILD=true next build && rm -rf out/data out/news-mockups && npx cap copy ios",
    "ios:open": "npx cap open ios",
    "ios:assets": "npx @capacitor/assets generate --ios --iconBackgroundColor '#0b0d10' --splashBackgroundColor '#0b0d10'",
    "ios:icon": "node scripts/make-app-icon.mjs",
    "fetch:fonts": "node scripts/fetch-fonts.mjs",
    "verify:native": "node scripts/verify-native-endpoints.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-market.ts"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
