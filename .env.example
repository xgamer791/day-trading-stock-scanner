# Market data (required for live accuracy on Pages — also set as GitHub Actions secret
# POLYGON_API_KEY so deploy embeds NEXT_PUBLIC_POLYGON_API_KEY for browser CORS)
POLYGON_API_KEY=
NEXT_PUBLIC_POLYGON_API_KEY=

# Optional owned CORS proxy (Cloudflare Worker — workers/quote-proxy/)
# NEXT_PUBLIC_QUOTE_PROXY_URL=https://your-worker.workers.dev

# Optional alias if using Massive.com rebrand credentials
# MASSIVE_API_KEY=
